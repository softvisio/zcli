{
    "name": "@softvisio/zcli",
    "version": "4.4.3",
    "description": "zCLI toolset",
    "keywords": [
        "zcli"
    ],
    "homepage": "https://softvisio.github.io/zcli/",
    "bugs": {
        "url": "https://github.com/softvisio/zcli/issues",
        "email": "root <root@softvisio.net>"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/softvisio/zcli.git"
    },
    "license": "ISC",
    "author": "root <root@softvisio.net>",
    "type": "module",
    "imports": {
        "#core/*": "@corejslib/core/*",
