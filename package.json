        "postcss": "^8.2.4",
        "prettier": "^3.0.0",
        "prettier-plugin-packagejson": "^3.0.0",
        "prettier-plugin-sh": "^0.19.0",
        "sharp": "^0.35.0",
        "terser": "^5.5.1",
        "typescript-eslint": "^8.0.0",
        "vue-eslint-parser": "^10.0.0"
