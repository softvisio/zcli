        "./resources/*": "./resources/*"
    },
    "bin": {
        "zcli": "bin/zcli.js"
    },
    "files": [
        "/bin",
        "/lib",
        "/resources",
        "/src"
    ],
    "scripts": {
        "install": "node bin/install.js",
        "test": "node --test \"tests/**/*.test.js\""
    },
    "dependencies": {
        "@corejslib/core": "^8.0.0",
        "@corejslib/eslint-plugin": "^1.0.1",
